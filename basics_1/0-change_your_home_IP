#!/usr/bin/env bash
# Configure localhost to resolve to 127.0.0.2 and facebook.com to 8.8.8.8
cp /etc/hosts "$HOME/hosts.new"
sed -i 's/^127\.0\.0\.1[[:space:]]\+localhost/127.0.0.2 localhost/' "$HOME/hosts.new"
sed -i '/facebook\.com/d' "$HOME/hosts.new"
echo "8.8.8.8 facebook.com" >> "$HOME/hosts.new"
cp -f "$HOME/hosts.new" /etc/hosts
